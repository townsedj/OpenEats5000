# Folders
site-media/
static-files/
node_modules/
secrets/*
.idea/
.vscode/

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
venv/
.pytest_cache/

# Local database (SQLite)
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# Files
*.DS_Store
*.css.map
*.js.map
*.log
.env
env_prod.list
docker-prod.version.yml
docker-prod.override.yml
docker-compose.override.yml

# Secrets, read by base/settings.py. This repository is public, so these
# lines are the only thing between a key and a scraper.
.secret_key
.anthropic_key

# base/settings.py ends with `from local_settings import *`, so this is
# where a local secret would naturally go. It was not ignored, which
# made it a direct route for an API key into a public repository.
local_settings.py

# USDA FoodData Central exports. Re-downloadable from
# fdc.nal.usda.gov/download-datasets and ~90MB unzipped, so the database
# that gets built from them is the artefact worth keeping, not these.
data/
